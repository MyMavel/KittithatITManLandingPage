# Copy this file to .env and fill in the values.

# SQLite database file (relative to the prisma/ directory).
DATABASE_URL="file:./dev.db"

# Admin login credentials for the /admin backend.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie. Use any long random string.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
