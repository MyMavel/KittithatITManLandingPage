# Copy this file to .env and fill in the values.
# Get these from your Supabase project: https://supabase.com/dashboard

# Public Supabase endpoint + anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# (Optional) Direct Postgres connection string — only needed if you want to
# run psql / pg_dump / migrations from your machine. NOT required by the app.
# DATABASE_URL="postgresql://postgres:<your-db-password>@db.<ref>.supabase.co:5432/postgres"
